scalar Time

type User {
  id: ID!
  platformId: String!
  name: String!
  role: String!
  familyGroup: String!
  createdAt: Time!
}

# A household (V4-30): the tenant, and where family-level settings live. An empty language,
# timeZone or currency means the install's default (DEFAULT_TIMEZONE, no language, USD).
type Household {
  id: ID!
  name: String!
  language: String!
  timeZone: String!
  currency: String!
  "Every opt-in feature pack, and whether the household has it on (V4-27). Core is always on and is not listed."
  packs: [Pack!]!
  "The household's topics: Core's, then those of each pack it has on (V4-27)."
  topics: [String!]!
}

# A feature pack (V4-27, DE-6). A pack that is off contributes no tools, prompt text, routing,
# dashboard page or briefing lines, and its fields here are refused; its data is kept.
type Pack {
  id: ID!
  name: String!
  description: String!
  enabled: Boolean!
  "The dashboard routes the pack owns; the dashboard hides them while the pack is off."
  pages: [String!]!
}

"What a new person does on one channel before their first message reaches MyPA (V4-41), shown with pairing codes."
type JoinStep {
  "The channel's name."
  channel: String!
  "One sentence the person can follow."
  step: String!
}

"One of a member's channel accounts, as an owner sees it (BL-41): the channel and the end of the number or handle, never all of it."
type MemberAccount {
  id: ID!
  personId: ID!
  channel: String!
  "The channel and the last four characters of the number or handle, e.g. '<channel> ending 0123'."
  label: String!
  linkedAt: Time!
}

type PairingCode {
  id: ID!
  code: String!
  role: String!
  familyGroup: String!
  expiresAt: Time!
  isUsed: Boolean!
  createdAt: Time!
}

# Topic 2: Topic-Mapped Memory & Knowledge Graph
type TopicMemory {
  id: ID!
  userId: String!
  familyGroup: String!
  topic: String!
  subtopic: String!
  tagsJson: String!
  fact: String!
  scope: String!
  createdByUserId: String!
  supersededById: Int
  validFrom: Time!
  validUntil: Time
  isPinned: Boolean!
  createdAt: Time!
}

type EntityProfile {
  id: ID!
  userId: String!
  familyGroup: String!
  topic: String!
  entityType: String!
  entityName: String!
  attributesJson: String!
  updatedByUserId: String!
  updatedAt: Time!
}

# Topic 9: Shared Spaces & Collaboration
type SharedSpace {
  id: ID!
  familyGroup: String!
  topic: String!
  ownerUserId: String!
  sharedWithUserId: String!
  canView: Boolean!
  canEdit: Boolean!
  notifyMode: String!
  updatedAt: Time!
}

type SharedTaskReminder {
  id: ID!
  familyGroup: String!
  topic: String!
  title: String!
  dueTime: Time
  createdByUserId: String!
  assignedToUserId: String
  isCompleted: Boolean!
  completedByUserId: String
  completedAt: Time
  createdAt: Time!
}

# Topic 3: Multi-Schedule Engine
type ScheduleEvent {
  id: ID!
  externalGoogleEventId: String!
  partnerGoogleEventId: String!
  userId: String!
  familyGroup: String!
  topic: String!
  tagsJson: String!
  title: String!
  description: String!
  startTime: Time!
  endTime: Time!
  recurrenceRule: String!
  syncToGoogle: Boolean!
  isShared: Boolean!
  createdByUserId: String!
  createdAt: Time!
}

type TopicCalendarConfig {
  id: ID!
  userId: String!
  topic: String!
  colorId: String!
  prefixTag: String!
  targetCalendarId: String!
  includeInMorningBriefing: Boolean!
  syncToGoogleDefault: Boolean
  updatedAt: Time!
}

# Topic 4: Baby & Family Care Tracker
type BabyProfile {
  id: ID!
  familyGroup: String!
  name: String!
  dateOfBirth: Time!
  dueDate: Time
  gender: String!
  birthWeightGrams: Int!
  currentWeightGrams: Int!
  heightCm: Float!
  pediatricianInfo: String!
  allergiesNotes: String!
  updatedByUserId: String!
  updatedAt: Time!
}

type BabyCareLog {
  id: ID!
  babyId: ID!
  familyGroup: String!
  logType: String!
  valueNumeric: Float!
  unit: String!
  details: String!
  timestamp: Time!
  loggedByUserId: String!
}

type BabyInventoryItem {
  id: ID!
  familyGroup: String!
  itemName: String!
  quantityRemaining: Float!
  unit: String!
  lowThreshold: Float!
  updatedAt: Time!
}

# Topic 5 & 8.1: House Maintenance, Contracts & Vehicle Vault
type HouseContractRecord {
  id: ID!
  familyGroup: String!
  recordType: String!
  title: String!
  vendorOrLandlord: String!
  contactDetails: String!
  amount: Float!
  currency: String!
  startDate: Time
  expirationOrRenewalDate: Time
  noticePeriodDays: Int!
  keyTermsJson: String!
  createdByUserId: String!
  createdAt: Time!
}

type HomeMaintenanceItem {
  id: ID!
  familyGroup: String!
  taskName: String!
  category: String!
  intervalDays: Int!
  lastCompletedAt: Time
  nextDueAt: Time!
  contractorInfo: String!
  notes: String!
  updatedByUserId: String!
}

type VehicleAsset {
  id: ID!
  familyGroup: String!
  name: String!
  licensePlate: String!
  insuranceExpiry: Time
  annualTestExpiry: Time
  lastServiceDate: Time
  currentMileageKm: Int!
  nextServiceMileageKm: Int!
  notes: String!
}

# Topic 6: Financial Tracking & Budget Intelligence
type FinancialTransaction {
  id: ID!
  userId: String!
  familyGroup: String!
  type: String!
  category: String!
  merchant: String!
  amount: Float!
  currency: String!
  transactionDate: Time!
  isShared: Boolean!
  source: String!
  notes: String!
  createdAt: Time!
  "Whether the caller logged it: only its own person can change or delete a transaction (BL-66)."
  isMine: Boolean!
}

type CategoryBudget {
  id: ID!
  familyGroup: String!
  category: String!
  monthlyLimit: Float!
  currency: String!
  alertThresholdPct: Float!
  createdAt: Time!
  updatedAt: Time!
}

type RecurringBill {
  id: ID!
  familyGroup: String!
  name: String!
  category: String!
  expectedAmount: Float!
  currency: String!
  billingCycle: String!
  nextDueDay: Int!
  autoRenew: Boolean!
  createdAt: Time!
  updatedAt: Time!
}

# Topics 7, 8.2 & 8.3: External APIs, Automations, Runtime Customization & CRM
type ExternalAPIConnector {
  id: ID!
  userId: String!
  familyGroup: String!
  name: String!
  baseUrl: String!
  defaultMethod: String!
  description: String!
  createdAt: Time!
}

type AutomationRule {
  id: ID!
  userId: String!
  familyGroup: String!
  name: String!
  triggerType: String!
  triggerTopic: String!
  conditionJson: String!
  actionInstruction: String!
  isActive: Boolean!
  createdAt: Time!
}

type UserPreference {
  userId: ID!
  preferredLanguage: String!
  tonePersona: String!
  defaultCurrency: String!
  quietHoursStart: String!
  quietHoursEnd: String!
  briefingTopicsJson: String!
  standingInstructions: String!
  updatedAt: Time!
}

type PersonalCRMContact {
  id: ID!
  userId: String!
  familyGroup: String!
  personName: String!
  relationship: String!
  importantDatesJson: String!
  giftIdeasAndSizes: String!
  medicalNotes: String!
  updatedAt: Time!
}

# Topic 1: Durability & Mutation Audit Logs
type MutationLog {
  id: ID!
  userId: String!
  familyGroup: String!
  topic: String!
  action: String!
  entityType: String!
  entityId: String!
  beforeJson: String
  afterJson: String
  summary: String!
  isUndone: Boolean!
  createdAt: Time!
}

type AuditSession {
  id: ID!
  userId: String!
  source: String!
  userPrompt: String!
  status: String!
  totalDurationMs: Int!
  startTime: Time!
}

type UserSessionSummary {
  userId: String!
  source: String!
  totalInteractions: Int!
  lastActive: Time!
}

"Chat model token usage and the daily caps (V4-04). Days are calendar days on the install's clock."
type Usage {
  "The install's time zone (DEFAULT_TIMEZONE): days are counted, and the caps start again at 00:00, on it."
  timeZone: String!
  "The daily cap per person, in tokens (LLM_DAILY_TOKENS_PER_PERSON); 0 means no cap."
  personDailyCap: Int!
  "The daily cap for the whole install, in tokens (LLM_DAILY_TOKENS_PER_INSTALL); 0 means no cap."
  installDailyCap: Int!
  "The tokens the caller used today."
  myTokensToday: Int!
  "The tokens the whole install used today: for the install's operator only, null for anyone else."
  installTokensToday: Int
  "Tokens per person and day, newest day first: each member's for an owner, the caller's own for anyone else."
  days: [UsageDay!]!
  "The latest turns, newest first, with the same visibility as days."
  turns: [TurnUsage!]!
}

"One person's tokens on one day."
type UsageDay {
  "YYYY-MM-DD on the install's clock."
  day: String!
  personId: ID!
  name: String!
  inputTokens: Int!
  outputTokens: Int!
  "Model calls, and the turns they belonged to."
  calls: Int!
  turns: Int!
}

"The tokens of one turn: the sum of its model calls."
type TurnUsage {
  "The turn's audit session ID."
  turnId: ID!
  personId: ID!
  name: String!
  startedAt: Time!
  inputTokens: Int!
  outputTokens: Int!
  calls: Int!
  "Who answered the turn's calls, comma-separated (more than one after a failover)."
  providers: String!
}

# The signed-in person (V4-35): who they are, their role in the household, and whether they are the
# install's operator.
type Me {
  personId: ID!
  name: String!
  role: String!
  isOperator: Boolean!
  household: Household!
}

# Every field acts as the signed-in person, in their own household (V4-35): the household is never
# an argument. Owners and adults may use the dashboard; children and guests may not. A row that
# belongs to one person (a personal memory, an unshared event or transaction, preferences and
# calendar settings) is visible and changeable only by that person; automations, connectors, CRM
# contacts and entity profiles are the household's, as in chat. Owners also see each member's
# activity, without the text of their chats.
type Query {
  "The signed-in person."
  me: Me!
  "The caller's own household."
  household: Household!
  "The household's members with their roles (owners); an adult sees only themselves."
  users: [User!]!
  activePairingCodes: [PairingCode!]!
  "A member's channel accounts, oldest first (owners only, the caller's own household, BL-41)."
  memberAccounts(personId: ID!): [MemberAccount!]!
  "Steps on each configured channel before a new person's first message, for an owner handing out a pairing code (V4-41). Empty when none needs one."
  joinSteps: [JoinStep!]!
  topicMemories(topic: String, includeSuperseded: Boolean): [TopicMemory!]!
  entityProfiles(topic: String, entityType: String): [EntityProfile!]!
  sharedSpaces: [SharedSpace!]!
  sharedTasks(topic: String, isCompleted: Boolean): [SharedTaskReminder!]!
  scheduleEvents(topic: String, startTime: Time, endTime: Time): [ScheduleEvent!]!
  topicCalendarConfigs(userId: String): [TopicCalendarConfig!]!
  babyProfiles: [BabyProfile!]!
  babyCareLogs(babyId: ID!, logType: String, limit: Int): [BabyCareLog!]!
  babyInventory: [BabyInventoryItem!]!
  houseContracts(recordType: String): [HouseContractRecord!]!
  homeMaintenanceItems(category: String): [HomeMaintenanceItem!]!
  vehicleAssets: [VehicleAsset!]!
  financialTransactions(category: String, limit: Int): [FinancialTransaction!]!
  categoryBudgets: [CategoryBudget!]!
  recurringBills: [RecurringBill!]!
  externalApiConnectors: [ExternalAPIConnector!]!
  automationRules: [AutomationRule!]!
  userPreference(userId: ID!): UserPreference
  personalCrmContacts: [PersonalCRMContact!]!
  mutationLogs(topic: String, limit: Int): [MutationLog!]!
  auditSessions(limit: Int): [AuditSession!]!
  userSessions: [UserSessionSummary!]!
  "Chat model usage and the daily caps (V4-04): the last `days` days, today included (default 14, at most 90)."
  usage(days: Int): Usage!
}

type Mutation {
  "End the current dashboard session (V4-35)."
  signOut: Boolean!
  "A pairing code for a new member (owners only): role is adult or child, never owner (a guest waits for sharing by name, BL-46)."
  generatePairingCode(role: String!): PairingCode!
  "Remove one of a member's channel accounts (owners only, the caller's own household; BL-41, ADR 0002 Decision 4). The last account cannot be removed. The person's other accounts and the owners are told, and the removal is written to the audit record."
  removeMemberAccount(personId: ID!, accountId: ID!): Boolean!
  "Change the caller's own household's settings (owners only). Omitted fields are unchanged; an empty string resets a setting to the install default."
  updateHousehold(name: String, language: String, timeZone: String, currency: String): Household!
  "Switch one of the caller's own household's feature packs on or off (owners only, V4-27). The pack's data is kept either way."
  setPackEnabled(pack: ID!, enabled: Boolean!): Household!
  saveTopicMemory(topic: String!, subtopic: String!, fact: String!, tagsJson: String, scope: String): TopicMemory!
  deleteTopicMemory(id: ID!): Boolean!
  pinTopicMemory(id: ID!, isPinned: Boolean!): TopicMemory!
  upsertEntityProfile(topic: String!, entityType: String!, entityName: String!, attributesJson: String!): EntityProfile!
  updateSharedSpace(topic: String!, sharedWithUserId: String!, canView: Boolean!, canEdit: Boolean!, notifyMode: String!): SharedSpace!
  createSharedTask(topic: String!, title: String!, dueTime: Time, assignedToUserId: String): SharedTaskReminder!
  completeSharedTask(id: ID!, completedByUserId: String!): SharedTaskReminder!
  createScheduleEvent(topic: String!, title: String!, description: String, startTime: Time!, endTime: Time!, tagsJson: String, syncToGoogle: Boolean, isShared: Boolean): ScheduleEvent!
  deleteScheduleEvent(id: ID!): Boolean!
  saveTopicCalendarConfig(topic: String!, colorId: String, prefixTag: String, includeInMorningBriefing: Boolean, syncToGoogleDefault: Boolean): TopicCalendarConfig!
  upsertBabyProfile(name: String!, dateOfBirth: Time!, gender: String!, currentWeightGrams: Int, heightCm: Float, pediatricianInfo: String, allergiesNotes: String): BabyProfile!
  logBabyCare(babyId: ID!, logType: String!, valueNumeric: Float, unit: String, details: String, timestamp: Time): BabyCareLog!
  updateBabyInventory(itemName: String!, quantityRemaining: Float!, unit: String!, lowThreshold: Float!): BabyInventoryItem!
  saveHouseContract(recordType: String!, title: String!, vendorOrLandlord: String, amount: Float, currency: String, expirationOrRenewalDate: Time, noticePeriodDays: Int, keyTermsJson: String): HouseContractRecord!
  saveHomeMaintenanceItem(taskName: String!, category: String!, intervalDays: Int!, nextDueAt: Time!, contractorInfo: String, notes: String): HomeMaintenanceItem!
  completeHomeMaintenance(id: ID!): HomeMaintenanceItem!
  saveVehicleAsset(name: String!, licensePlate: String!, insuranceExpiry: Time, annualTestExpiry: Time, currentMileageKm: Int, nextServiceMileageKm: Int, notes: String): VehicleAsset!
  logFinancialTransaction(type: String!, category: String!, merchant: String!, amount: Float!, currency: String!, notes: String, isShared: Boolean): FinancialTransaction!
  "Change one of the caller's own transactions (BL-66): sharing, amount, category, merchant, date, type, currency or notes. Omitted fields are unchanged. Only the person who logged it can, an owner included; undoable from the audit page."
  updateFinancialTransaction(id: ID!, type: String, category: String, merchant: String, amount: Float, currency: String, transactionDate: Time, notes: String, isShared: Boolean): FinancialTransaction!
  "Delete one of the caller's own transactions (BL-66). Only the person who logged it can, an owner included; undoable from the audit page."
  deleteFinancialTransaction(id: ID!): Boolean!
  setCategoryBudget(category: String!, monthlyLimit: Float!, currency: String!, alertThresholdPct: Float): CategoryBudget!
  saveRecurringBill(name: String!, category: String!, expectedAmount: Float!, currency: String!, billingCycle: String!, nextDueDay: Int!, autoRenew: Boolean!): RecurringBill!
  registerExternalApi(name: String!, baseUrl: String!, defaultMethod: String, description: String): ExternalAPIConnector!
  saveAutomationRule(name: String!, triggerType: String!, triggerTopic: String!, conditionJson: String!, actionInstruction: String!, isActive: Boolean): AutomationRule!
  toggleAutomationRule(id: ID!, isActive: Boolean!): AutomationRule!
  deleteAutomationRule(id: ID!): Boolean!
  saveUserPreference(userId: ID!, preferredLanguage: String, tonePersona: String, defaultCurrency: String, quietHoursStart: String, quietHoursEnd: String, standingInstructions: String): UserPreference!
  savePersonalCrmContact(personName: String!, relationship: String, importantDatesJson: String, giftIdeasAndSizes: String, medicalNotes: String): PersonalCRMContact!
  rollbackMutation(mutationId: ID!): Boolean!
}

