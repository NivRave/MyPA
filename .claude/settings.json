{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push * master*)",
      "Bash(git push *:master*)",
      "Bash(git tag *)",
      "Bash(git push --tags*)",
      "Bash(git push * --tags*)",
      "Bash(git push --follow-tags*)",
      "Bash(git push * --follow-tags*)",
      "Bash(git push * tag *)",
      "Bash(git push * refs/tags/*)",
      "Bash(git push * v*)",
      "Bash(docker compose up*)",
      "Bash(docker compose * up)",
      "Bash(docker compose * up *)",
      "Bash(docker compose down*)",
      "Bash(docker compose * down)",
      "Bash(docker compose * down *)",
      "Bash(docker-compose up*)",
      "Bash(docker-compose * up)",
      "Bash(docker-compose * up *)",
      "Bash(docker-compose down*)",
      "Bash(docker-compose * down)",
      "Bash(docker-compose * down *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push * +*)",
      "PowerShell(git push * master*)",
      "PowerShell(git push *:master*)",
      "PowerShell(git tag *)",
      "PowerShell(git push --tags*)",
      "PowerShell(git push * --tags*)",
      "PowerShell(git push --follow-tags*)",
      "PowerShell(git push * --follow-tags*)",
      "PowerShell(git push * tag *)",
      "PowerShell(git push * refs/tags/*)",
      "PowerShell(git push * v*)",
      "PowerShell(docker compose up*)",
      "PowerShell(docker compose * up)",
      "PowerShell(docker compose * up *)",
      "PowerShell(docker compose down*)",
      "PowerShell(docker compose * down)",
      "PowerShell(docker compose * down *)",
      "PowerShell(docker-compose up*)",
      "PowerShell(docker-compose * up)",
      "PowerShell(docker-compose * up *)",
      "PowerShell(docker-compose down*)",
      "PowerShell(docker-compose * down)",
      "PowerShell(docker-compose * down *)",
      "Edit(.env)",
      "Edit(**/.env)"
    ]
  }
}
