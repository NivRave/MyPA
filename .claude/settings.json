{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push * master*)",
      "Bash(git push *:master*)",
      "Bash(git push --tags*)",
      "Bash(git push * --tags*)",
      "Bash(git push --follow-tags*)",
      "Bash(git push * --follow-tags*)",
      "Bash(git push * tag *)",
      "Bash(git push * refs/tags/*)",
      "Bash(docker compose up*)",
      "Bash(docker compose * up)",
      "Bash(docker compose * up *)",
      "Bash(docker compose down*)",
      "Bash(docker compose * down)",
      "Bash(docker compose * down *)",
      "Bash(docker-compose up*)",
      "Bash(docker-compose * up)",
      "Bash(docker-compose * up *)",
      "Bash(docker-compose down*)",
      "Bash(docker-compose * down)",
      "Bash(docker-compose * down *)",
      "Bash(*MYPA_RELEASE*)",
      "Bash(git push --no-verify*)",
      "Bash(git push * --no-verify*)",
      "Bash(git config *core.hooksPath*)",
      "Bash(git config *core.hookspath*)",
      "Bash(git -c *core.hooksPath*)",
      "Bash(git -c *core.hookspath*)",
      "Bash(*> .env*)",
      "Bash(*>.env*)",
      "Bash(*>*/.env*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push * +*)",
      "PowerShell(git push * master*)",
      "PowerShell(git push *:master*)",
      "PowerShell(git push --tags*)",
      "PowerShell(git push * --tags*)",
      "PowerShell(git push --follow-tags*)",
      "PowerShell(git push * --follow-tags*)",
      "PowerShell(git push * tag *)",
      "PowerShell(git push * refs/tags/*)",
      "PowerShell(docker compose up*)",
      "PowerShell(docker compose * up)",
      "PowerShell(docker compose * up *)",
      "PowerShell(docker compose down*)",
      "PowerShell(docker compose * down)",
      "PowerShell(docker compose * down *)",
      "PowerShell(docker-compose up*)",
      "PowerShell(docker-compose * up)",
      "PowerShell(docker-compose * up *)",
      "PowerShell(docker-compose down*)",
      "PowerShell(docker-compose * down)",
      "PowerShell(docker-compose * down *)",
      "PowerShell(*MYPA_RELEASE*)",
      "PowerShell(git push --no-verify*)",
      "PowerShell(git push * --no-verify*)",
      "PowerShell(git config *core.hooksPath*)",
      "PowerShell(git config *core.hookspath*)",
      "PowerShell(git -c *core.hooksPath*)",
      "PowerShell(git -c *core.hookspath*)",
      "PowerShell(*> .env*)",
      "PowerShell(*>.env*)",
      "PowerShell(*>*/.env*)",
      "Edit(.env)",
      "Edit(**/.env)",
      "Edit(/.githooks/**)",
      "Write(/.githooks/**)"
    ]
  }
}
