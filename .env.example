# MyPA environment template — copy to .env and fill in.
# Each service validates its own keys at startup (internal/config/validate.go) and refuses to
# start, listing every missing/placeholder value, if something it needs is absent.
# Legend:  [REQUIRED: services]   [CONDITIONAL: rule]   [optional]
# Generate secrets with:  openssl rand -hex 32

# ---------------------------------------------------------------- Server / auth
# [optional] Bootstrap users. Format: "phone_or_chat_id:Name:Role:FamilyGroup, ..."
# Example: "+972501234567:Nivik:admin:MyFamily, +972507654321:Jane:family:MyFamily"
ALLOWED_USERS=
# [REQUIRED: orchestrator] Bearer secret the dashboard/proxy use to call /graphql.
DASHBOARD_API_SECRET=your-dashboard-api-secret
# [REQUIRED: orchestrator] The dashboard secret acts as an admin of THIS family group only
# (cannot read or change other families). Use the family group name from ALLOWED_USERS.
DASHBOARD_FAMILY_GROUP=your-family-group
# [REQUIRED: orchestrator] HMAC-SHA256 JWT signing secret. Must differ from ENCRYPTION_KEY.
JWT_SECRET=your-jwt-signing-secret
# [REQUIRED: orchestrator] AES-256-GCM key for OAuth tokens / API headers at rest.
# Changing it makes existing encrypted credentials unreadable (users must /connect again).
ENCRYPTION_KEY=your-32-byte-encryption-key

# [optional] debug|info|warn|error (default info). User message text is only logged at debug.
LOG_LEVEL=info
# [optional] Default IANA timezone for the assistant (e.g. Asia/Jerusalem); default UTC.
DEFAULT_TIMEZONE=Asia/Jerusalem
# [optional] Household calendar conventions used in the system prompt.
WEEK_START_DAY=Sunday
WEEKEND_DAYS=Friday,Saturday

# [REQUIRED: proxy] Upstreams. docker-compose.yml sets these for the proxy container (and
# compose `environment:` wins over this file); only matters when running the proxy outside Docker.
GATEWAY_URL=http://localhost:8080
ORCHESTRATOR_URL=http://localhost:8081

# ---------------------------------------------------------------- Telegram
# [optional — enables Telegram] Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# [optional] When set, the gateway calls setWebhook with this URL + TELEGRAM_SECRET_TOKEN on
# startup. [CONDITIONAL] requires TELEGRAM_BOT_TOKEN.
TELEGRAM_WEBHOOK_URL=https://your-ngrok-url.ngrok-free.app/webhook/telegram
# [CONDITIONAL: gateway, when TELEGRAM_BOT_TOKEN or TELEGRAM_WEBHOOK_URL is set]
# 1-256 chars of A-Z a-z 0-9 _ -  (openssl rand -hex 32)
TELEGRAM_SECRET_TOKEN=your-telegram-webhook-secret-token

# ---------------------------------------------------------------- RabbitMQ
# [REQUIRED: gateway, orchestrator, audit-worker]
RABBITMQ_URL=amqp://<YOUR_RABBITMQ_USER>:<YOUR_RABBITMQ_PASSWORD>@rabbitmq:5672/
RABBITMQ_DEFAULT_USER=<YOUR_RABBITMQ_USER>
RABBITMQ_DEFAULT_PASS=<YOUR_RABBITMQ_PASSWORD>
# [optional] Max concurrent conversation turns (different users run in parallel; one user's
# messages are always processed in order). Default 4.
RABBITMQ_PREFETCH=4

# ---------------------------------------------------------------- Redis
# [REQUIRED: orchestrator]
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------- Database (PostgreSQL)
# [REQUIRED: orchestrator, audit-worker]
DATABASE_URL=postgres://<YOUR_DB_USER>:<YOUR_DB_PASSWORD>@postgres:5432/<YOUR_DB_NAME>?sslmode=disable
POSTGRES_USER=<YOUR_DB_USER>
POSTGRES_PASSWORD=<YOUR_DB_PASSWORD>
POSTGRES_DB=<YOUR_DB_NAME>
PGADMIN_DEFAULT_EMAIL=<YOUR_PGADMIN_EMAIL>
PGADMIN_DEFAULT_PASSWORD=<YOUR_PGADMIN_PASSWORD>

# ---------------------------------------------------------------- Gemini
# [REQUIRED: orchestrator]
GEMINI_API_KEY=your-gemini-api-key
# [optional] default gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------- Optional integrations
# [optional] Tavily web search (search_web)
TAVILY_API_KEY=tvly-your_api_key_here
# [optional] Google OAuth for Calendar / Gmail / Tasks / Contacts
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8081/auth/google/callback
# [optional] Groq Whisper voice transcription
GROQ_API_KEY=your-groq-api-key

# ---------------------------------------------------------------- Twilio (WhatsApp)
# [optional — enables WhatsApp]
TWILIO_ACCOUNT_SID=your-twilio-account-sid
# [CONDITIONAL: gateway, orchestrator, when TWILIO_ACCOUNT_SID is set]
# The gateway also rejects every WhatsApp webhook while this is empty.
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=whatsapp:+14155238886

# ---------------------------------------------------------------- Backups
# [recommended] age public key(s) to encrypt backups (generate: age-keygen -o backup.key).
# Empty = backups are written UNENCRYPTED.
BACKUP_AGE_RECIPIENTS=
# [restore only] path to the age private key; keep it off the server, mount only to restore.
BACKUP_AGE_IDENTITY_FILE=

# ---------------------------------------------------------------- Ngrok
NGROK_AUTHTOKEN=your-ngrok-authtoken
NGROK_DOMAIN=your-ngrok-url.ngrok-free.dev
