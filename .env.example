# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://your-ngrok-url.ngrok-free.app/webhook/telegram

# RabbitMQ
RABBITMQ_URL=amqp://mypa:mypa_dev@rabbitmq:5672/

# Redis
REDIS_URL=redis://redis:6379/0

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Google OAuth (for Calendar)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8081/auth/google/callback

# Groq (for Whisper Voice Transcription)
GROQ_API_KEY=your-groq-api-key
