# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://your-ngrok-url.ngrok-free.app/webhook/telegram

# RabbitMQ
RABBITMQ_URL=amqp://mypa:mypa_dev@rabbitmq:5672/

# Redis
REDIS_URL=redis://redis:6379/0

# Database (PostgreSQL)
DATABASE_URL=postgres://mypa:mypa_password@postgres:5432/mypa?sslmode=disable

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Tavily API (Web Search)
TAVILY_API_KEY=tvly-your_api_key_here

# Google OAuth (for Calendar)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8081/auth/google/callback

# Groq (for Whisper Voice Transcription)
GROQ_API_KEY=your-groq-api-key

# Twilio (for WhatsApp)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=whatsapp:+14155238886
