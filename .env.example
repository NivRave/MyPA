# Server Settings
# Format: "phone_or_chat_id:Name:Role:FamilyGroup, phone_or_chat_id2:Name2:Role2:FamilyGroup2"
# Example: "+972501234567:Nivik:admin:MyFamily, +972507654321:Jane:family:MyFamily"
ALLOWED_USERS=
DASHBOARD_API_SECRET=your-dashboard-api-secret
JWT_SECRET=your-jwt-signing-secret

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# When set, the gateway calls setWebhook with this URL + TELEGRAM_SECRET_TOKEN on startup.
TELEGRAM_WEBHOOK_URL=https://your-ngrok-url.ngrok-free.app/webhook/telegram
# REQUIRED when TELEGRAM_BOT_TOKEN or TELEGRAM_WEBHOOK_URL is set — the gateway refuses to start without it.
# 1-256 chars of A-Z a-z 0-9 _ -  (generate with: openssl rand -hex 32)
TELEGRAM_SECRET_TOKEN=your-telegram-webhook-secret-token

# RabbitMQ
RABBITMQ_URL=amqp://<YOUR_RABBITMQ_USER>:<YOUR_RABBITMQ_PASSWORD>@rabbitmq:5672/
RABBITMQ_DEFAULT_USER=<YOUR_RABBITMQ_USER>
RABBITMQ_DEFAULT_PASS=<YOUR_RABBITMQ_PASSWORD>

# Redis
REDIS_URL=redis://redis:6379/0

# Database (PostgreSQL)
DATABASE_URL=postgres://<YOUR_DB_USER>:<YOUR_DB_PASSWORD>@postgres:5432/<YOUR_DB_NAME>?sslmode=disable
POSTGRES_USER=<YOUR_DB_USER>
POSTGRES_PASSWORD=<YOUR_DB_PASSWORD>
POSTGRES_DB=<YOUR_DB_NAME>
PGADMIN_DEFAULT_EMAIL=<YOUR_PGADMIN_EMAIL>
PGADMIN_DEFAULT_PASSWORD=<YOUR_PGADMIN_PASSWORD>

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Tavily API (Web Search)
TAVILY_API_KEY=tvly-your_api_key_here

# Google OAuth (for Calendar)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8081/auth/google/callback

# Groq (for Whisper Voice Transcription)
GROQ_API_KEY=your-groq-api-key

# Twilio (for WhatsApp)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
# REQUIRED when TWILIO_ACCOUNT_SID is set — the gateway refuses to start without it,
# and rejects every WhatsApp webhook if it is empty.
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=whatsapp:+14155238886
# Encryption (AES-256-GCM, 32-byte key)
ENCRYPTION_KEY=your-32-byte-encryption-key

# Ngrok
NGROK_AUTHTOKEN=your-ngrok-authtoken
NGROK_DOMAIN=your-ngrok-url.ngrok-free.dev

